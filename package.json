{
  "name": "sailing-auto-judge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "帆船赛自动裁判系统 — 基于世界帆联竞赛规则(RRS)的实时判罚引擎与回放申诉平台",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
